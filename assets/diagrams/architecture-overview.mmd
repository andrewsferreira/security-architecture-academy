flowchart LR
  accTitle: Visão geral da arquitetura de segurança
  accDescr: Objetivos de negócio orientam a gestão de riscos, que define políticas e requisitos. Os requisitos são implementados por controles de identidade, rede, dados e aplicações, que protegem workloads distribuídos entre ambientes on-premises e cloud. O monitoramento contínuo retroalimenta a gestão de riscos.

  subgraph GOV["Governança"]
    direction TB
    BIZ["Objetivos de negócio"] --> RISK["Gestão de riscos"]
    RISK --> POL["Políticas e requisitos"]
  end

  subgraph CTRL["Controles de segurança"]
    direction TB
    IAM["Identidades e acessos"]
    NET["Segmentação de rede"]
    DATA["Proteção de dados"]
    APP["Segurança de aplicações"]
  end

  subgraph ENV["Ambientes híbridos"]
    direction TB
    ONP["Workloads on-premises"]
    CLD["Workloads em cloud"]
  end

  POL --> CTRL
  CTRL --> ENV
  ENV -. "telemetria e evidências" .-> MON["Monitoramento contínuo"]
  MON -. "riscos residuais e incidentes" .-> RISK

  classDef control stroke:#0e9fb8,stroke-width:2px
  classDef identity stroke:#2f74e8,stroke-width:2px
  class IAM identity
  class NET,DATA,APP control
  classDef zone fill:transparent,stroke:#64748b,stroke-width:1px,stroke-dasharray:4 3
  class GOV,CTRL,ENV zone
