root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{md,py}]
indent_size = 4

[*.md]
# Quebras de linha com dois espaços não são usadas; manter a limpeza.
trim_trailing_whitespace = true

[Makefile]
indent_style = tab
