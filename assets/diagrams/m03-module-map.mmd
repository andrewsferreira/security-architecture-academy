  L02 --> L03["Aula 03 · Seleção e tailoring<br/>de controles"]
  L01 --> L05["Aula 05 · BIA, RTO e RPO"]
  L05 --> L06["Aula 06 · Risk assessment<br/>e risk register"]
  L04 --> L06
  L03 --> L07["Aula 07 · Catálogo de controles e<br/>arquitetura baseada em risco"]
  L06 --> L07
  L07 --> L08["Aula 08 · Indicadores, maturidade<br/>e reporte"]
  L08 --> M04(["Módulo 4"])

